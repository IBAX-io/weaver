  "scripts": {
    "build-css": "sass --load-path=./src/app/styles/scss --load-path=./node_modules src/app/styles/scss/sass.scss src/app/styles/built/sass.css",
    "watch-css": "npm run build-css && sass --load-path=./src/app/styles/scss --load-path=./node_modules src/app/styles/scss/sass.scss src/app/styles/built/sass.css --watch",
    "start-js": "craco start",
    "start": "cross-env REACT_APP_VERSION=$npm_package_version npm-run-all -p watch-css start-js",
    "build": "npm run build-css && cross-env REACT_APP_VERSION=$npm_package_version craco build",
    "test": "craco test --env=jsdom",
    "eject": "react-scripts eject",
    "start-desktop": "cross-env REACT_APP_VERSION=$npm_package_version npm-run-all -p watch-css start-js",
    "build-desktop": "npm run build-css && cross-env PUBLIC_URL=./ REACT_APP_VERSION=$npm_package_version craco build",
    "package": "electron-builder --config electron-builder.json --dir",
    "release": "electron-builder --config electron-builder.json",
    "serve": "now ./build -A ../now.json -n ibax"
  },
