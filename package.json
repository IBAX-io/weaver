  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build-desktop": "vite build --mode desktop && vite build -c vite.electron.config.ts --mode main && vite build -c vite.electron.config.ts --mode preload",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-builder --config electron-builder.config.mjs --dir",
    "release": "electron-builder --config electron-builder.config.mjs",
    "start-desktop": "vite build -c vite.electron.config.ts --mode main && vite build -c vite.electron.config.ts --mode preload && electron build --dev-server=http://127.0.0.1:3000",
    "test:desktop": "npm run build-desktop && vitest run -c vitest.desktop.config.ts"
  },
